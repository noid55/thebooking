@using thebooking.Models
@model Room

<h2>Room Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Room Id</dt>
        <dd class="col-sm-10">@Model.RoomId</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Capacity</dt>
        <dd class="col-sm-10">@Model.Capacity</dd>

        @* Building is loaded with lazy loading *@
        <dt class="col-sm-2">Building</dt>
        <dd class="col-sm-10">@Model.Building?.Name</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        @* Conditional rendering (if/else): equipment comes from the N:M relationship Room <-> Equipment
           via RoomEquipment. Shown as a comma-separated list or "No equipment" if the room has none. *@
        <dt class="col-sm-2">Equipment</dt>
        <dd class="col-sm-10">
            @if (Model.RoomEquipments != null && Model.RoomEquipments.Any())
            {
                @string.Join(", ", Model.RoomEquipments.Select(re => re.Equipment.Name))
            }
            else
            {
                <span>No equipment</span>
            }
        </dd>
    </dl>

        @* Upcoming bookings: only confirmed bookings that have not ended, sorted by time.
       Cancelled and past bookings are hidden. The topic is only shown for open sessions,
       so private sessions stay private, but students can still see when the room is taken. *@
    @{
        var upcomingBookings = (Model.Bookings ?? new List<Booking>())
            .Where(b => b.Status == BookingStatus.Confirmed && b.EndTime > DateTime.Now)
            .OrderBy(b => b.StartTime)
            .ToList();
    }

    <h3>Upcoming bookings</h3>
    @if (upcomingBookings.Any())
    {
        <ul class="list-group mb-3">
            @foreach (var booking in upcomingBookings)
            {
                <li class="list-group-item">
                    <strong>@booking.StartTime.ToString("dd.MM.yyyy HH:mm") - @booking.EndTime.ToString("HH:mm")</strong>
                    @* Conditional rendering (if/else): open sessions show course and topic, private sessions do not *@
                    @if (booking.IsOpen)
                    {
                        <span>· @booking.Course:</span>
                        <a asp-controller="Booking" asp-action="Details" asp-route-id="@booking.BookingId">@booking.Topic</a>
                        <span class="badge bg-success">Open</span>
                    }
                    else
                    {
                        <span>· Private session</span>
                        <span class="badge bg-dark">Private</span>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <p>No upcoming bookings. The room is free.</p>
    }
    <a asp-action="Table" class="btn btn-secondary">Back to Table View</a>
    <a asp-controller="Booking" asp-action="Create" asp-route-roomId="@Model.RoomId" 
    class="btn btn-primary">Book this room</a>
    </div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
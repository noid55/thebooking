@model thebooking.ViewModels.RoomSearchViewModel

<h1>Rooms</h1>
<a asp-controller="Room" asp-action="Create" class="btn btn-primary mb-3">Create new room</a>

@* Search form. method="get" puts the search in the URL, so the search can be bookmarked or shared. *@
<form asp-action="Table" method="get" class="card card-body mb-3">
    <div class="row">
        <div class="col-md-4 form-group">
            <label for="buildingId">Building</label>
            <select name="buildingId" id="buildingId" class="form-control" asp-items="Model.BuildingSelectList">
                <option value="">All buildings</option>
            </select>
        </div>
        <div class="col-md-3 form-group">
            <label for="minCapacity">Minimum seats</label>
            <input type="number" name="minCapacity" id="minCapacity" value="@Model.MinCapacity" min="1" max="20" class="form-control" />
        </div>
        <div class="col-md-5 form-group">
            <label>Equipment</label><br />
            @foreach (var equipment in Model.EquipmentSelectList)
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="equipmentIds"
                           value="@equipment.Value" id="search-equipment-@equipment.Value" checked="@equipment.Selected" />
                    <label class="form-check-label" for="search-equipment-@equipment.Value">@equipment.Text</label>
                </div>
            }
        </div>
    </div>
    <div class="mt-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Table" class="btn btn-secondary">Clear</a>
    </div>
</form>

@* Conditional rendering (if/else): message when no rooms match the search *@
@if (!Model.Rooms.Any())
{
    <div class="alert alert-info">No rooms match your search.</div>
}
else
{
    <table class="table table-striped">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Capacity</th>
            <th>Description</th>
            <th>Building</th>
            <th>Equipment</th>
            <th></th>
        </tr>
        @foreach (var room in Model.Rooms)
        {
            <tr>
                <td>@room.RoomId</td>
                <td><a asp-action="Details" asp-route-id="@room.RoomId">@room.Name</a></td>
                <td>@room.Capacity</td>
                <td>@room.Description</td>
                <td>@room.Building?.Name</td>
                @* Equipment comes from the N:M relationship Room <-> Equipment *@
                <td>@string.Join(", ", room.RoomEquipments?.Select(re => re.Equipment.Name) ?? new List<string>())</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@room.RoomId" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@room.RoomId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </table>
}
@model IEnumerable<thebooking.Models.Building>
<h1>@ViewBag.CurrentViewName</h1>
<a asp-action="Create" class="btn btn-primary">Create new building</a>
<table class="table table-striped">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Address</th>
        <th>Rooms</th>
        <th></th>
    </tr>
    @foreach (var building in Model)
    {
        <tr>
            <td>@building.BuildingId</td>
            <td><a asp-action="Details" asp-route-id="@building.BuildingId">@building.Name</a></td>
            <td>@building.Address</td>
            <td>@(building.Rooms?.Count ?? 0)</td> @*antall rom i bygget*@
            <td>
                <a asp-action="Edit" asp-route-id="@building.BuildingId" class="btn btn-primary btn-sm">Edit</a>
                <a asp-action="Delete" asp-route-id="@building.BuildingId" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
</table>
@model thebooking.Models.Building

<h2>Delete Building</h2>
<h3>Are you sure you want to delete this building?</h3>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div>
    <dl class="row">
        <dt class="col-sm-2">Building Id</dt>
        <dd class="col-sm-10">@Model.BuildingId</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.Address</dd>
    </dl>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.BuildingId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Table" class="btn btn-secondary">Cancel</a>
    </form>
</div>
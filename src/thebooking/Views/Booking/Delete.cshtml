@model thebooking.Models.Booking

<h2>Delete Booking</h2>
<h3>Are you sure you want to permanently delete this booking?</h3>
<p>To keep the booking in the history, use "Cancel booking" on the details page instead.</p>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div>
    <dl class="row">
        <dt class="col-sm-2">Room</dt>
        <dd class="col-sm-10">@Model.Room?.Name (@Model.Room?.Building?.Name)</dd>

        <dt class="col-sm-2">Topic</dt>
        <dd class="col-sm-10">@Model.Topic</dd>

        <dt class="col-sm-2">Time</dt>
        <dd class="col-sm-10">@Model.StartTime.ToString("dd.MM.yyyy HH:mm") - @Model.EndTime.ToString("HH:mm")</dd>
    </dl>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.BookingId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Table" class="btn btn-secondary">Cancel</a>
    </form>
</div>
@using Microsoft.AspNetCore.Identity
@using thebooking.Models
@model Booking
@inject UserManager<IdentityUser> UserManager

@{
    // Only the owner of the booking or an admin can edit, cancel or delete it
    var canManage = Model.UserId == UserManager.GetUserId(User) || User.IsInRole("Admin");
}

<h2>Booking Details</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">Booking Id</dt>
        <dd class="col-sm-10">@Model.BookingId</dd>

        <dt class="col-sm-2">Room</dt>
        <dd class="col-sm-10">@Model.Room?.Name (@Model.Room?.Building?.Name)</dd>

        <dt class="col-sm-2">Course</dt>
        <dd class="col-sm-10">@Model.Course</dd>

        <dt class="col-sm-2">Topic</dt>
        <dd class="col-sm-10">@Model.Topic</dd>

        <dt class="col-sm-2">Start time</dt>
        <dd class="col-sm-10">@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</dd>

        <dt class="col-sm-2">End time</dt>
        <dd class="col-sm-10">@Model.EndTime.ToString("dd.MM.yyyy HH:mm")</dd>

        @* The user who made the booking. User is loaded with lazy loading. *@
        <dt class="col-sm-2">Booked by</dt>
        <dd class="col-sm-10">@Model.User?.UserName</dd>

        @* Number of participants. The owner is included, so + 1. *@
        <dt class="col-sm-2">Participants</dt>
        <dd class="col-sm-10">@((Model.Participations?.Count ?? 0) + 1) / @Model.MaxParticipants</dd>

        @* Conditional rendering (ternary): shows whether the session is open or private *@
        <dt class="col-sm-2">Open</dt>
        <dd class="col-sm-10">@(Model.IsOpen ? "Yes, other students can join" : "No, private session")</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">
            <span class="badge @(Model.Status == BookingStatus.Confirmed ? "bg-success" : "bg-secondary")">@Model.Status</span>
        </dd>

        <dt class="col-sm-2">Created</dt>
        <dd class="col-sm-10">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
    </dl>

    @* Edit and cancel are only shown to the owner or an admin, and only if the booking is confirmed and has not started *@
    @if (canManage && Model.Status == BookingStatus.Confirmed && Model.StartTime > DateTime.Now)
    {
        <a asp-action="Edit" asp-route-id="@Model.BookingId" class="btn btn-primary">Edit</a>
        <form asp-action="Cancel" asp-route-id="@Model.BookingId" method="post" class="d-inline">
            <button type="submit" class="btn btn-warning">Cancel booking</button>
        </form>
    }
    @if (canManage)
    {
        <a asp-action="Delete" asp-route-id="@Model.BookingId" class="btn btn-danger">Delete</a>
    }
    <a asp-action="MyBookings" class="btn btn-secondary">Back to My Bookings</a>
</div>
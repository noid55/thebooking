@model thebooking.ViewModels.OpenSessionsViewModel

<h1>Find study groups</h1>
<p class="text-muted">Open study sessions that have not started yet. Open a session to join it.</p>

@* Search form. method="get" puts the search in the URL. *@
<form asp-action="Open" method="get" class="card card-body mb-3">
    <div class="row">
        <div class="col-md-4 form-group">
            <label for="course">Course</label>
            <input type="text" name="course" id="course" value="@Model.Course" class="form-control" placeholder="e.g. DATA1500" />
        </div>
        <div class="col-md-4 form-group">
            <label for="buildingId">Building</label>
            <select name="buildingId" id="buildingId" class="form-control" asp-items="Model.BuildingSelectList">
                <option value="">All buildings</option>
            </select>
        </div>
        <div class="col-md-4 form-group">
            <label for="date">Date</label>
            <input type="date" name="date" id="date" value="@Model.Date?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
    </div>
    <div class="mt-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Open" class="btn btn-secondary">Clear</a>
    </div>
</form>

@* Conditional rendering (if/else): message when no sessions match the search *@
@if (!Model.Sessions.Any())
{
    <div class="alert alert-info">No open study groups match your search.</div>
}
else
{
    <div class="row">
        @foreach (var session in Model.Sessions)
        {
            // The owner counts as one of the participants
            var participantCount = (session.Participations?.Count ?? 0) + 1;
            var spotsLeft = session.MaxParticipants - participantCount;

            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@session.Course</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@session.Topic</h6>
                        <p class="card-text">
                            @session.Room?.Name (@session.Room?.Building?.Name)<br />
                            @session.StartTime.ToString("dd.MM.yyyy HH:mm") - @session.EndTime.ToString("HH:mm")<br />
                            Participants: @participantCount / @session.MaxParticipants
                        </p>
                        @* Conditional rendering (ternary): grey badge when full, green when there are free spots *@
                        <span class="badge @(spotsLeft > 0 ? "bg-success" : "bg-secondary")">
                            @(spotsLeft > 0 ? $"{spotsLeft} spots left" : "Full")
                        </span>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a asp-action="Details" asp-route-id="@session.BookingId" class="btn btn-primary btn-sm">View session</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
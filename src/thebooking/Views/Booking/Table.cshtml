@using Microsoft.AspNetCore.Identity
@using thebooking.Models
@model IEnumerable<Booking>
@inject UserManager<IdentityUser> UserManager

@{
    var currentUserId = UserManager.GetUserId(User);
    var isAdmin = User.IsInRole("Admin");
}

<h1>@ViewBag.CurrentViewName</h1>
<a asp-action="Create" class="btn btn-primary">Book a room</a>

@if (!Model.Any())
{
    <p>No bookings.</p>
}
else
{
    <table class="table table-striped">
        <tr>
            <th>Id</th>
            <th>Room</th>
            <th>Course</th>
            <th>Topic</th>
            <th>Date</th>
            <th>Time</th>
            <th>Participants</th>
            <th>Status</th>
            <th></th>
        </tr>
        @foreach (var booking in Model)
        {
            <tr>
                <td>@booking.BookingId</td>
                <td>@booking.Room?.Name (@booking.Room?.Building?.Name)</td>
                <td>@booking.Course</td>
                <td><a asp-action="Details" asp-route-id="@booking.BookingId">@booking.Topic</a></td>
                <td>@booking.StartTime.ToString("dd.MM.yyyy")</td>
                <td>@booking.StartTime.ToString("HH:mm") - @booking.EndTime.ToString("HH:mm")</td>
                @* Participants / max. The owner is included, so + 1. *@
                <td>@((booking.Participations?.Count ?? 0) + 1) / @booking.MaxParticipants</td>
                <td>
                    @* Status badge: green for confirmed bookings, grey for cancelled ones *@
                    <span class="badge @(booking.Status == BookingStatus.Confirmed ? "bg-success" : "bg-secondary")">@booking.Status</span>
                    @* Conditional rendering (if): extra badge when the session is private *@
                    @if (!booking.IsOpen)
                    {
                        <span class="badge bg-dark">Private</span>
                    }
                </td>
                <td>
                    @* Edit and Delete are only shown to the owner of the booking or an admin *@
                    @if (booking.UserId == currentUserId || isAdmin)
                    {
                        @* Edit is hidden when the booking is cancelled or has already started (same rule as BookingService.CanBeChanged) *@
                        @if (booking.Status == BookingStatus.Confirmed && booking.StartTime > DateTime.Now)
                        {
                            <a asp-action="Edit" asp-route-id="@booking.BookingId" class="btn btn-primary btn-sm">Edit</a>
                        }
                        <a asp-action="Delete" asp-route-id="@booking.BookingId" class="btn btn-danger btn-sm">Delete</a>
                    }
                </td>
            </tr>
        }
    </table>
}
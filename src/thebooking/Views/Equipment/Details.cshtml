@model thebooking.Models.Equipment

<h2>Equipment Details</h2>
<div>
    <dl class="row">
        <dt class="col-sm-2">Equipment Id</dt>
        <dd class="col-sm-10">@Model.EquipmentId</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
    </dl>

    <h3>Rooms with this equipment</h3>
    @if (Model.RoomEquipments != null && Model.RoomEquipments.Any())
    {
        <ul>
            @foreach (var roomEquipment in Model.RoomEquipments)
            {
                <li>
                    <a asp-controller="Room" asp-action="Details" asp-route-id="@roomEquipment.RoomId">@roomEquipment.Room.Name</a>
                    (@roomEquipment.Room.Building?.Name)
                </li>
            }
        </ul>
    }
    else
    {
        <p>No rooms have this equipment.</p>
    }

    <a asp-action="Table" class="btn btn-secondary">Back to Table View</a>
</div>
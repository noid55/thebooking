@model thebooking.Models.Message

<h2>Edit Message</h2>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Edit">
    <input type="hidden" asp-for="MessageId" />
    <input type="hidden" asp-for="BookingId" />
    <div class="form-group">
        <label asp-for="Text"></label><span class="text-danger">*</span>
        <textarea asp-for="Text" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Text" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Save</button>
    <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-secondary mt-2">Cancel</a>
</form>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
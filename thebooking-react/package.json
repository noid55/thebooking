{
  "name": "thebooking-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first \"npm run backend\" \"wait-on tcp:5234 && npm run frontend\"",
    "build": "eslint . && vite build",
